{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Net Lantern",
  "identifier": "dev.netlantern.app",
  "app": { "windows": [], "security": { "csp": null } },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "shortDescription": "See what's on your Wi-Fi and why the internet broke.",
    "publisher": "Net Lantern",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "windows/hooks.nsh",
        "displayLanguageSelector": false,
        "customLanguageFiles": { "English": "windows/English.nsh" }
      }
    }
  }
}
